# Auto detect text files and normalize line endings to LF
* text=auto

# C/C++ source and header files
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf

# CMake files
CMakeLists.txt text eol=lf
*.cmake text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.exe binary
*.o binary
*.a binary
*.so binary
*.dll binary

# Build artifacts - don't normalize
build/** -text
